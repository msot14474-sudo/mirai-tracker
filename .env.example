NODE_ENV=development

# Browser and API
WEB_PORT=5173
API_PORT=3000
VITE_API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=mirai_tracker
POSTGRES_USER=mirai
POSTGRES_PASSWORD=mirai_local_password
DATABASE_URL=postgresql://mirai:mirai_local_password@postgres:5432/mirai_tracker?schema=public

# Redis and job processing
REDIS_URL=redis://redis:6379

# Private API credential shared only by the API and background worker
INTERNAL_API_URL=http://api:3000
INTERNAL_JOB_SECRET=replace-with-a-long-random-job-secret

# Local email capture
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notifications@mirai.local
SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Replace before any public deployment
SESSION_SECRET=replace-with-a-long-random-secret

# Fictional accounts created only by the local seed command
DEMO_USER_PASSWORD=replace-with-a-local-demo-password
