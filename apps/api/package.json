{
  "name": "@mirai/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @mirai/calculations build && prisma generate && node scripts/generate-ai-guide.cjs && nest build && node scripts/deploy-migrations.cjs",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:schema": "jest --runInBand src/database/schema.contract.spec.ts",
    "test:database": "jest --config jest.database.config.cjs --runInBand",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "verify:demo": "tsx prisma/verify-demo.ts"
  },
  "dependencies": {
    "@mirai/calculations": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "exceljs": "4.4.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "nodemailer": "^10.0.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
