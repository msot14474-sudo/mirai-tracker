NODE_ENV=production

# Runtime traffic: Supabase transaction pooler for Vercel serverless functions.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1

# Migration traffic: Supabase session pooler (or direct connection when IPv6 is
# available). Production builds use this only when a migration must be applied.
DIRECT_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
REDIS_URL=rediss://default:TOKEN@HOST:6379

# Replace with the deployed React project's production URL.
WEB_ORIGIN=https://mirai-tracker.vercel.app

# Generate two independent values of at least 32 characters.
SESSION_SECRET=replace-with-an-independent-random-session-secret
INTERNAL_JOB_SECRET=replace-with-an-independent-random-worker-secret

# Configure a real SMTP service before enabling missed-log emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=notifications@example.com
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password

# Google OAuth Web application. Register this exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mirai-tracker.vercel.app/api/auth/google/callback

# Optional academic AI (server only). Never use VITE_ for the key.
AI_PROVIDER=ollama
AI_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# Optional conversational WhatsApp logging. See docs/whatsapp-logging.md.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
