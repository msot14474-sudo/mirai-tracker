# Public HTTPS address. Point this domain's DNS A/AAAA record to the server.
APP_DOMAIN=tracker.example.edu
APP_ORIGIN=https://tracker.example.edu

# Generate independent URL-safe values; never reuse these examples.
POSTGRES_DB=mirai_tracker
POSTGRES_USER=mirai
POSTGRES_PASSWORD=generate-a-long-url-safe-database-password
REDIS_PASSWORD=generate-a-long-url-safe-redis-password
SESSION_SECRET=generate-an-independent-random-value-of-at-least-32-characters
INTERNAL_JOB_SECRET=generate-another-independent-random-value-of-at-least-32-characters

# Real transactional SMTP account supplied by the deployer.
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_FROM=notifications@example.edu
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# DEMO_USER_PASSWORD is deliberately absent. Supply it only to the one-time
# seed command; do not leave it in the production service environment.
